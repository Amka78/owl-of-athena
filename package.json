{
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "eas:ios:dev": "bash scripts/eas-build.sh ios development",
    "eas:android:dev": "bash scripts/eas-build.sh android development",
    "eas:ios:preview": "bash scripts/eas-build.sh ios preview",
    "eas:android:preview": "bash scripts/eas-build.sh android preview",
    "eas:ios:prod": "bash scripts/eas-build.sh ios production",
    "eas:android:prod": "bash scripts/eas-build.sh android production",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src/",
    "test": "bun test",
    "upload": "bunx netlify deploy --dir dist",
    "upload-nightly": "bunx netlify deploy --dir dist --site=6cae492d-4f2c-474f-8a5c-5a3aa1da2d45 --prod",
    "upload-staging": "bunx netlify deploy --dir dist --site=0f596f14-3130-4b11-9bc8-61fa84cce680 --prod",
    "upload-prod": "bunx netlify deploy --dir dist --prod",
    "coverage": "bun test --coverage",
    "clean-install": "rm -rf node_modules && bun install",
    "ncu": "bunx npm-check-updates -u && bun install",
    "storybook": "start-storybook -p 6006",
    "build-storybook": "build-storybook",
    "fix-types": "rm -rf node_modules/@types/react-native-vector-icons/node_modules node_modules/@types/react-native",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "desktop": "bun run src-electrobun/main.ts",
    "build:desktop": "bun run build:web && bunx electrobun build",
    "build:desktop:release": "bun run build:web && bunx electrobun build --env=stable",
    "desktop:dev": "concurrently \"expo start --web\" \"sleep 5 && bunx electrobun dev\"",
    "format": "biome format --write src/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/"
  },

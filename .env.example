# -----------------------------------------------
# 開発環境設定テンプレート
# 実際の値は .env.local に書いてください。
# このファイルはgitにコミットしても安全です。
# -----------------------------------------------

# ネットワーク設定（センシティブではない）
REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.x
ADB_IP=192.168.1.x
ANDROID_SDK=/usr/lib/android-sdk

# Supabase（Supabase Dashboard > Settings > API から取得）
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY_HERE

# Webで確実に参照したい場合はこちらも併用可（Expo Public Env）
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY_HERE

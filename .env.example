# -----------------------------------------------
# 開発環境設定テンプレート
# 実際の値は .env.local に書いてください。
# このファイルはgitにコミットしても安全です。
# -----------------------------------------------

# プロジェクト共通の設定（.env に置いてよい）
ADB_IP=192.168.1.x
ANDROID_SDK=/usr/lib/android-sdk

# -----------------------------------------------
# 以下は .env.local 専用（.env に書くと Expo SDK 58 の
# @expo/env が「Refused to load personal environment variables
# from a non-.local env file」で起動を拒否する）
# -----------------------------------------------
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.x
# BROWSER=wslview
# ANDROID_HOME=/usr/lib/android-sdk

# Supabase（Supabase Dashboard > Settings > API から取得）
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY_HERE

# Webで確実に参照したい場合はこちらも併用可（Expo Public Env）
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY_HERE

# -----------------------------------------------
# 仮想 Aurora 端末（開発・エミュレータ検証専用。実機・本番には設定しない）
# 詳細は VIRTUAL_AURORA_DEVICE.md を参照
# -----------------------------------------------
# エミュレータで実機 Bluetooth なしに接続後の画面を試す（1 で有効）
# EXPO_PUBLIC_VIRTUAL_AURORA=1
# os-info のファームウェア Version（既定 99900 = 更新提示が出ない高値。
# フラッシュフローの検証では更新対象になる旧バージョンを指定する）
# EXPO_PUBLIC_VIRTUAL_AURORA_VERSION=30000
# BATTERY_MONITOR / os-info のバッテリー残量 %（既定 100。低バッテリー遷移の検証で下げる）
# EXPO_PUBLIC_VIRTUAL_AURORA_BATTERY=15
# 就寝シナリオを短縮する（1 で有効: prof-load からアラーム発火まで既定 20 秒）
# EXPO_PUBLIC_VIRTUAL_AURORA_FAST=1
# FAST 時のアラーム発火までの秒数（既定 20）
# EXPO_PUBLIC_VIRTUAL_AURORA_SLEEP_SECONDS=30